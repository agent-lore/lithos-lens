# Lithos Lens multi-env Docker configuration.
# Copy to .env.dev or .env.prod and fill in values.
# Files matching .env.* (except .env.example) are gitignored.

# Human label surfaced to the running container (app code can read it).
LITHOS_LENS_ENVIRONMENT=dev

# Host path mounted at /data inside the container.
LITHOS_LENS_DATA_PATH=./data

# Container name — must be unique per environment so stacks can coexist.
LITHOS_LENS_CONTAINER_NAME=lithos-lens-dev

# Host port that publishes the web UI from container port 8000.
LITHOS_LENS_HOST_PORT=8000

# OTLP collector endpoint (the lithos-observability stack). Compose reads this
# and passes it through as LITHOS_LENS_OTEL_ENDPOINT.
#
# Leave it UNSET and the container still installs telemetry and still stamps
# trace ids on its logs -- it just exports nothing, so the service is absent
# from Grafana while looking healthy from the inside. That is a quiet failure
# mode, and it is why this is documented here rather than left to the compose
# file: an environment created from this template gets no telemetry and nothing
# says so.
#
# host.docker.internal is mapped to the host gateway by compose's extra_hosts,
# the same route the Lithos URL uses.
LITHOS_LENS_OTEL_ENDPOINT=http://host.docker.internal:4318

# Optional overrides.
# LITHOS_LENS_IMAGE=lithos-lens:dev
# LITHOS_LENS_UID=1000
# LITHOS_LENS_GID=1000
